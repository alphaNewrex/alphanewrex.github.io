---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import NavMenu from "../components/NavMenu.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import GlobeWidget from "../components/globe-widget/GlobeWidget.astro";
import DotField from "../components/DotField.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const {
  image,
  imageAlt,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  noindex = false,
  type,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="lofi">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <DotField />
    {includeSidebar && <NavMenu activeId={sideBarActiveItemID} />}
    <ThemeToggle />
    <main class="mx-auto w-full max-w-[900px] px-6 pt-24 lg:pt-16 pb-6">
      <slot />
    </main>
    <Footer />
    <GlobeWidget />
  </body>
</html>
