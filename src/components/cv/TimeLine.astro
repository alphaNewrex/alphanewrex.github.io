---
// One entry in a CV timeline: a dot marker joined to the next entry by a dotted line.
const { title, subtitle } = Astro.props;
---

<div class="tl">
	<div class="tl-rail" aria-hidden="true">
		<span class="tl-dot"></span>
		<span class="tl-line"></span>
	</div>
	<div class="tl-body">
		<h3 class="font-semibold text-lg leading-snug">{title}</h3>
		<p class="tl-sub">{subtitle}</p>
		<div class="tl-content">
			<slot />
		</div>
	</div>
</div>

<style>
	.tl {
		display: flex;
		gap: 18px;
	}
	.tl-rail {
		flex: none;
		width: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.tl-dot {
		width: 12px;
		height: 12px;
		margin-top: 6px;
		border-radius: 999px;
		border: 2px solid var(--ds-ink);
		background: var(--ds-surface);
		transition: background 160ms ease, border-color 160ms ease, transform 220ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}
	.tl:hover .tl-dot {
		background: var(--ds-accent);
		border-color: var(--ds-accent);
		transform: scale(1.2);
	}
	.tl-line {
		flex: 1;
		width: 2px;
		margin: 6px 0 2px;
		background-image: radial-gradient(circle, var(--ds-ink-faint) 1px, transparent 1.5px);
		background-size: 2px 7px;
		background-repeat: repeat-y;
	}
	.tl:last-child .tl-line {
		visibility: hidden;
	}
	.tl-body {
		min-width: 0;
		padding-bottom: 26px;
	}
	.tl:last-child .tl-body {
		padding-bottom: 0;
	}
	.tl-sub {
		margin-top: 4px;
		font-size: 0.875rem;
		opacity: 0.65;
	}
	.tl-content {
		margin-top: 10px;
		line-height: 1.6;
	}
	.tl-content :global(ul) {
		list-style: disc;
		margin-left: 1.25rem;
		display: grid;
		gap: 6px;
	}
</style>
