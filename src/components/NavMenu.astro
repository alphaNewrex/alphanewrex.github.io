// 3x3 dot grid icon. The four edge dots fade out when open, leaving an X.
const iconDots = [0, 1, 2].flatMap((row) => [0, 1, 2].map((col) => ({ col, row, edge: (row + col) % 2 === 1 })));
---

<nav class="nm" data-nm aria-label="Site">
	<div class="nm-scrim" aria-hidden="true"></div>

	<button class="nm-toggle" type="button" aria-expanded="false" aria-controls="nm-list" aria-label="Open menu">
		<svg viewBox="0 0 30 30" aria-hidden="true">
			{
				iconDots.map(({ col, row, edge }) => (
					<circle class:list={['nm-dot', { 'nm-dot-edge': edge }]} cx={5 + col * 10} cy={5 + row * 10} r="2.6" />
				))
			}
		</svg>
	</button>

	<div class="nm-list" id="nm-list" inert>
		<ul>
			{
				links.map((link, i) => (
					<li style={`--i: ${i}`}>
						<a
							class:list={['nm-pill', { 'is-active': link.id === activeId }]}
							href={link.href}
							aria-current={link.id === activeId ? 'page' : undefined}
						>
							<span class="nm-bullet" aria-hidden="true" />
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
		<ul class="nm-socials" style={`--i: ${links.length}`}>
			{
				socials.map((s, i) => (
					<li style={`--j: ${i}`}>
						<a class="nm-social" href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path fill-rule="evenodd" d={s.path} />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<style>
	.nm-toggle {
		position: fixed;
		top: 20px;
		left: 20px;
		z-index: 61;
		width: 56px;
		height: 56px;
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: var(--ds-surface);
		border: 1px solid var(--ds-line);
		box-shadow: var(--ds-shadow-sm);
		cursor: pointer;
		transition: transform 220ms var(--ds-ease-spring), box-shadow 200ms ease;
	}
	.nm-toggle:hover {
		transform: translateY(-2px) scale(1.06);
		box-shadow: var(--ds-shadow-md);
	}
	.nm-toggle:active {
		transform: scale(0.94);
	}
	.nm-toggle svg {
		width: 22px;
		overflow: visible;
		transition: transform 420ms var(--ds-ease-spring);
	}
	.nm.is-open .nm-toggle svg {
		transform: rotate(90deg);
	}
	.nm-dot {
		fill: var(--ds-ink);
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 260ms var(--ds-ease-spring), opacity 180ms ease, fill 200ms ease;
	}
	.nm.is-open .nm-dot-edge {
		opacity: 0;
		transform: scale(0.2);
	}
	.nm.is-open .nm-dot:not(.nm-dot-edge) {
		transform: scale(1.15);
	}
	.nm.is-open .nm-dot:nth-child(5) {
		fill: var(--ds-accent);
	}

	.nm-scrim {
		position: fixed;
		inset: 0;
		z-index: 59;
		background: color-mix(in oklab, var(--ds-surface) 55%, transparent);
		backdrop-filter: blur(3px);
		-webkit-backdrop-filter: blur(3px);
		opacity: 0;
		visibility: hidden;
		transition: opacity 220ms ease, visibility 0s linear 220ms;
	}
	.nm.is-open .nm-scrim {
		opacity: 1;
		visibility: visible;
		transition: opacity 260ms ease, visibility 0s;
	}

	.nm-list {
		position: fixed;
		top: 88px;
		left: 20px;
		z-index: 60;
		max-height: calc(100dvh - 108px);
		overflow-y: auto;
		/* Room for pill shadows and the hover nudge. */
		padding: 4px 16px 16px 4px;
		margin: -4px;
		visibility: hidden;
		transition: visibility 0s linear 300ms;
	}
	.nm.is-open .nm-list {
		visibility: visible;
		transition: visibility 0s;
	}
	.nm-list ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}

	/* Each item drops in on its own, top to bottom; closing reverses quickly. */
	.nm-list li,
	.nm-socials {
		opacity: 0;
		transform: translateY(-14px) scale(0.92);
		transform-origin: top left;
		transition:
			opacity 140ms ease,
			transform 200ms ease;
	}
	.nm.is-open .nm-list > ul:first-child > li,
	.nm.is-open .nm-socials {
		opacity: 1;
		transform: none;
		transition:
			opacity 220ms ease calc(var(--i) * 38ms),
			transform 460ms var(--ds-ease-spring) calc(var(--i) * 38ms);
	}
	.nm-socials li {
		opacity: 1;
		transform: none;
	}

	.nm-pill {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 10px 18px 10px 14px;
		border-radius: 999px;
		background: var(--ds-surface);
		border: 1px solid var(--ds-line);
		box-shadow: var(--ds-shadow-sm);
		font-size: 16px;
		font-weight: 500;
		line-height: 1;
		color: var(--ds-ink);
		text-decoration: none;
		transition:
			transform 220ms var(--ds-ease-spring),
			box-shadow 200ms ease,
			background 160ms ease;
	}
	.nm-pill:hover {
		transform: translateX(5px);
		box-shadow: var(--ds-shadow-md);
	}
	.nm-bullet {
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: var(--ds-ink-faint);
		transition: background 160ms ease, transform 220ms var(--ds-ease-spring);
	}
	.nm-pill:hover .nm-bullet {
		background: var(--ds-accent);
		transform: scale(1.3);
	}
	.nm-pill.is-active {
		background: var(--ds-ink);
		color: var(--ds-on-ink);
		border-color: var(--ds-ink);
	}
	.nm-pill.is-active .nm-bullet {
		background: var(--ds-accent);
	}

	.nm-socials {
		flex-direction: row !important;
		margin-top: 6px !important;
	}
	.nm-social {
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: var(--ds-surface);
		border: 1px solid var(--ds-line);
		box-shadow: var(--ds-shadow-sm);
		color: var(--ds-ink);
		transition: transform 220ms var(--ds-ease-spring), color 160ms ease;
	}
	.nm-social:hover {
		transform: translateY(-3px);
		color: var(--ds-accent);
	}
	.nm-social svg {
		width: 19px;
		fill: currentColor;
	}

	.nm button:focus-visible,
	.nm a:focus-visible {
		outline: 2px solid var(--ds-accent);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.nm-toggle {
			top: 14px;
			left: 14px;
		}
		.nm-list {
			top: 80px;
			left: 14px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nm-list li,
		.nm-socials,
		.nm.is-open .nm-list > ul:first-child > li,
		.nm.is-open .nm-socials {
			transform: none;
			transition: opacity 150ms ease;
		}
		.nm-toggle svg,
		.nm.is-open .nm-toggle svg {
			transform: none;
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-nm]');
	if (nav) {
		const toggle = nav.querySelector<HTMLButtonElement>('.nm-toggle')!;
		const list = nav.querySelector<HTMLElement>('.nm-list')!;
		const scrim = nav.querySelector<HTMLElement>('.nm-scrim')!;
		let open = false;

		const setOpen = (next: boolean, restoreFocus = false) => {
			open = next;
			nav.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			list.inert = !open;
			if (open) list.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
			else if (restoreFocus) toggle.focus();
		};

		toggle.addEventListener('click', () => setOpen(!open));
		scrim.addEventListener('click', () => setOpen(false));
		list.addEventListener('click', (e) => {
			if ((e.target as Element).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && open) setOpen(false, true);
		});
		// Pages restored from the back/forward cache come back with the menu closed.
		window.addEventListener('pageshow', () => open && setOpen(false));
	}
</script>
