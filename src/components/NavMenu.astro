---
// Site navigation: a round dot-matrix button fixed top-left that drops the
// links down as separate pills. Replaces the old daisyUI drawer sidebar.
interface Props {
	activeId?: string;
}
const { activeId } = Astro.props;

const links = [
	{ id: 'home', label: 'Home', href: '/' },
	{ id: 'projects', label: 'Projects', href: '/projects' },
	{ id: 'photos', label: 'Photos', href: '/photos' },
	{ id: 'blog', label: 'Blog', href: '/blog/' },
	{ id: 'cv', label: 'CV', href: '/cv' },
	{ id: 'resume', label: 'Resume', href: '/resume' },
	{ id: 'contact', label: 'Contact', href: 'mailto:hgujarathi3@gatech.edu' },
];

const socials = [
	{
		label: 'GitHub',
		href: 'https://github.com/alphaNewrex',
