---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageIntro from '../components/PageIntro.astro'

const PDF_URL = '/Harsh_Gujarathi_Resume.pdf'
---

<BaseLayout
	title='Resume'
	description='Resume of Harsh Gujarathi, software engineer and ML systems researcher. View it here or download the PDF.'
	sideBarActiveItemID='resume'
>
	<PageIntro title='Resume'>
		<div class='flex flex-wrap gap-3'>
			<a class='ds-btn ds-btn--primary ds-btn--sm' href={PDF_URL} download>
				Download PDF
			</a>
			<a class='ds-btn ds-btn--secondary ds-btn--sm' href={PDF_URL} target='_blank' rel='noopener'>
				Open in new tab
			</a>
		</div>
	</PageIntro>

	<div class='resume-viewer mt-5' data-pdf={PDF_URL}>
		<p class='resume-status'>Loading resume…</p>
		<noscript>
			<p class='resume-status'>
				<a class='ds-link' href={PDF_URL}>Open the resume PDF</a>
			</p>
		</noscript>
	</div>
</BaseLayout>

<style>
	.resume-viewer {
		display: grid;
		gap: 20px;
	}
	.resume-viewer :global(canvas) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 14px;
		background: #fff;
		border: 1px solid var(--ds-line-strong);
		box-shadow: var(--ds-shadow-md);
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 400ms ease,
			transform 500ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}
	.resume-viewer :global(canvas.is-ready) {
		opacity: 1;
		transform: none;
	}
	.resume-status {
		padding: 28px;
		border-radius: 20px;
		text-align: center;
		background: var(--ds-surface);
		border: 1px solid var(--ds-line-strong);
		color: var(--ds-ink-muted);
	}
	@media (prefers-reduced-motion: reduce) {
		.resume-viewer :global(canvas) {
			transform: none;
			transition: opacity 150ms ease;
		}
	}
</style>

<script>
	import * as pdfjs from 'pdfjs-dist'
	import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url'

	pdfjs.GlobalWorkerOptions.workerSrc = workerUrl

	const viewer = document.querySelector<HTMLElement>('.resume-viewer')
	const status = viewer?.querySelector<HTMLElement>('.resume-status')

	async function render() {
		if (!viewer) return
		const url = viewer.dataset.pdf!
		try {
			const doc = await pdfjs.getDocument({ url }).promise
			const canvases: HTMLCanvasElement[] = []
			for (let n = 1; n <= doc.numPages; n++) {
				const canvas = document.createElement('canvas')
				canvas.setAttribute('role', 'img')
				canvas.setAttribute('aria-label', `Resume page ${n} of ${doc.numPages}`)
				viewer.append(canvas)
				canvases.push(canvas)
			}
			status?.remove()

			const draw = async () => {
				// Render at the displayed width times the pixel ratio so text stays crisp.
				const cssWidth = viewer.clientWidth
				const ratio = Math.min(window.devicePixelRatio || 1, 3)
				for (let n = 1; n <= doc.numPages; n++) {
					const page = await doc.getPage(n)
					const base = page.getViewport({ scale: 1 })
					const viewport = page.getViewport({ scale: (cssWidth / base.width) * ratio })
					const canvas = canvases[n - 1]
					canvas.width = Math.floor(viewport.width)
					canvas.height = Math.floor(viewport.height)
					await page.render({ canvas, viewport }).promise
					canvas.classList.add('is-ready')
				}
			}
			await draw()

			// Re-render when the column width changes (rotation, window resize).
			let lastWidth = viewer.clientWidth
			let timer = 0
			new ResizeObserver(() => {
				if (Math.abs(viewer.clientWidth - lastWidth) < 40) return
				lastWidth = viewer.clientWidth
				window.clearTimeout(timer)
				timer = window.setTimeout(draw, 200)
			}).observe(viewer)
		} catch (error) {
			console.error(error)
			if (status) {
				status.innerHTML = `Couldn't display the resume here. <a class="ds-link" href="${url}">Open the PDF</a> instead.`
			}
		}
	}

	render()
</script>
