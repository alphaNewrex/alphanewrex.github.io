---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageIntro from '../components/PageIntro.astro'
import Panel from '../components/Panel.astro'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { photoCaptions } from '../data/photo-captions'

// Drop a file into src/images/photos/ and it shows up here. No edit needed.
const files = import.meta.glob<{ default: ImageMetadata }>(
	'/src/images/photos/*.{png,jpg,jpeg,webp}',
	{ eager: true },
)

const photos = Object.entries(files)
	.map(([path, mod]) => {
		const name = path.split('/').pop()!.replace(/\.[^.]+$/, '')
		return {
			name,
			src: mod.default,
			caption: photoCaptions[name],
			// Filename doubles as alt text when no caption is set.
			alt: photoCaptions[name] ?? name.replace(/[-_]+/g, ' '),
		}
	})
	.sort((a, b) => a.name.localeCompare(b.name))
---

<BaseLayout
	title='Photos'
	description='Photos I have taken, and a few of me.'
	sideBarActiveItemID='photos'
>
	<PageIntro title='Photos'>
		<p>Photos I have taken, and a few of me.</p>
	</PageIntro>

	{
		photos.length === 0 ? (
			<Panel>
				<p class='font-bold'>Nothing here yet.</p>
				<p class='ds-muted'>Photos will show up once there are some to show.</p>
			</Panel>
		) : (
			<div class='columns-2 lg:columns-3 gap-4 mt-5'>
				{photos.map((photo) => (
					<figure class='photo-frame break-inside-avoid mb-4'>
						<Image
							src={photo.src}
							widths={[320, 640, 960]}
							sizes='(max-width: 1024px) 50vw, 33vw'
							format='webp'
							alt={photo.alt}
							loading='lazy'
							class='w-full h-auto rounded-xl'
						/>
						{photo.caption && (
							<figcaption class='text-sm ds-muted mt-2 px-1'>
								{photo.caption}
							</figcaption>
						)}
					</figure>
				))}
			</div>
		)
	}
</BaseLayout>

<style>
	.photo-frame {
		padding: 8px;
		border-radius: 18px;
		background: var(--ds-surface);
		border: 1px solid var(--ds-line-strong);
		transition:
			transform 300ms cubic-bezier(0.34, 1.4, 0.64, 1),
			box-shadow 300ms ease;
	}
	.photo-frame:hover {
		transform: translateY(-3px);
		box-shadow: 0 14px 34px rgb(0 0 0 / 0.12);
	}
</style>
