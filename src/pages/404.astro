---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found" description="This page does not exist." includeSidebar={false} noindex>
  <div class="text-center">
    <div class="text-9xl font-bold mb-4" aria-hidden="true">🏝</div>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <h3 class="text-2xl">Ooops! Looks like you're lost in space! 🚀</h3>
    <a class="ds-btn ds-btn--primary mt-9" href="/">Home</a>
  </div>
</BaseLayout>