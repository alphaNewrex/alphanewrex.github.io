{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harshgujarathi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* invokes the Worker; every other request is served as a free static asset.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visitors",
      "database_id": "2afd4c7d-ad42-402e-8cd8-67cad7ca415f"
    }
  ],
  "observability": { "enabled": true }
}
