{
  "$schema": "node_modules/wrangler/config-schema.json",
  // API-only Worker for the visitor globe. The site itself is hosted on GitHub Pages
  // and calls this Worker cross-origin; see worker/index.ts for the allowed origins.
  "name": "harshgujarathi-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visitors",
      "database_id": "2afd4c7d-ad42-402e-8cd8-67cad7ca415f"
    }
  ],
  "observability": { "enabled": true }
}
